# All optional. Every example runs read-only with none of these set.

# Raises your rate limit from 30 to 120 req/min. Free, instant, no review:
# https://docs.ravn.exchange/tools/get-api-key
RAVN_API_KEY=

# Only needed to actually broadcast a swap (btc-out.ts with EXECUTE=1).
PRIVATE_KEY=
USER_ADDRESS=

# Where native BTC should land.
BTC_DESTINATION=

# Only for agent-swap.ts
ANTHROPIC_API_KEY=
